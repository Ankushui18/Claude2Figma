{
  "manifest_version": 3,
  "name": "Claude2Figma — Claude Design to Figma",
  "version": "1.8.0",
  "description": "Capture Claude Design & web pages as local .deck.json files that import to Figma as native editable layers. No account, no server.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude2Figma",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.claudeusercontent.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "storage",
    "unlimitedStorage",
    "downloads",
    "clipboardWrite"
  ]
}
